# ─── Required for live data ───────────────────────────────────────────────
# Bayut via RapidAPI. Powers property listings (host uae-real-estate2) AND
# DLD transactions (host uae-real-estate3). ONE key — but your RapidAPI account
# must be subscribed to BOTH APIs. Listings work on the base subscription;
# for real transactions, also subscribe to the transactions API (free tier),
# otherwise the app falls back to labeled "Market estimate" data.
RAPIDAPI_KEY=

# OpenAI — AI matching, property analysis, and floor-plan reimagine.
OPENAI_API_KEY=

# ─── Optional ─────────────────────────────────────────────────────────────
# Model overrides. Defaults: text/vision = gpt-4o, image = gpt-image-1.
# Set OPENAI_MODEL=gpt-4o-mini to optimise for cost, or a newer flagship.
# NOTE: gpt-image-1 (floor-plan reimagine) requires a VERIFIED OpenAI org.
OPENAI_MODEL=
OPENAI_VISION_MODEL=
OPENAI_IMAGE_MODEL=

# Force bundled mock data (offline/demo). Set to 'false' to use the live APIs.
NEXT_PUBLIC_USE_MOCK=false
